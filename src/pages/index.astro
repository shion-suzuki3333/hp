---
import "../styles/global.css";
import { profile, research, activities, contact } from "../content";

const pageTitle = `${profile.name} | ${profile.university}`;
const pageDescription = `${profile.name}（${profile.university}）。${profile.tagline}`;
const base = import.meta.env.BASE_URL;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" href={`${base}favicon.ico`} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={pageDescription} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500&family=Shippori+Mincho:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site">
      <header class="hero">
        <div class="wrap">
          <h1 class="hero__brand">{profile.name}</h1>
          <p class="hero__meta">
            <span>{profile.university}</span>
            <span>{profile.affiliation}</span>
          </p>
          <p class="hero__tagline">{profile.tagline}</p>
          <div class="hero__actions">
            <a class="btn btn--primary" href="#contact">連絡先へ</a>
            <a class="btn btn--ghost" href="#research">研究を見る</a>
          </div>
        </div>
      </header>

      <main>
        <section class="section" id="research" aria-labelledby="research-title">
          <div class="wrap reveal">
            <p class="section__label">{research.title}</p>
            <h2 class="section__title" id="research-title">{research.headline}</h2>
            <p class="section__body">{research.body}</p>
          </div>
        </section>

        <section class="section" id="activities" aria-labelledby="activities-title">
          <div class="wrap reveal">
            <p class="section__label">{activities.title}</p>
            <h2 class="section__title" id="activities-title">これまでに参加したこと</h2>
            <ol class="timeline">
              {
                activities.items.map((item) => (
                  <li class="timeline__item">
                    <time class="timeline__date" datetime={item.date.replace(".", "-")}>
                      {item.date}
                    </time>
                    <p class="timeline__text">{item.text}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </section>

        <section class="section" id="contact" aria-labelledby="contact-title">
          <div class="wrap reveal">
            <p class="section__label">{contact.title}</p>
            <h2 class="section__title" id="contact-title">ご連絡はこちら</h2>
            {contact.lead && <p class="section__body">{contact.lead}</p>}
            <ul class="contact-list">
              {
                profile.emails.map((mail) => (
                  <li class="contact-list__item">
                    <span class="contact-list__label">{mail.label}</span>
                    <a class="contact-mail" href={`mailto:${mail.address}`}>
                      {mail.address}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </section>
      </main>

      <footer class="footer">
        <div class="wrap">
          <p>© {new Date().getFullYear()} {profile.nameEn}</p>
        </div>
      </footer>
    </div>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.18, rootMargin: "0px 0px -8% 0px" },
      );

      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>
  </body>
</html>
